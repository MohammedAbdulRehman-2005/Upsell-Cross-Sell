# Plural WhatsApp Upsell / Cross-Sell Automation Backend

APP_NAME="Plural Upsell & Cross-Sell Service"
APP_VERSION="0.2.0"
ENVIRONMENT="development"
DEBUG="false"
LOG_LEVEL="INFO"
API_V1_PREFIX="/api/v1"

# Database configuration (PostgreSQL; host port defaults to 5433 in Docker Compose)
POSTGRES_HOST="localhost"
POSTGRES_PORT="5433"
POSTGRES_USER="plural_user"
POSTGRES_PASSWORD="change_me_in_local_env"
POSTGRES_DB="plural_upsell"
# Optional explicit SQLAlchemy URL override:
# DATABASE_URL="postgresql+psycopg://plural_user:change_me_in_local_env@localhost:5433/plural_upsell"

# Isolated test database URL (used by pytest when running against PostgreSQL)
TEST_DATABASE_URL="postgresql+psycopg://plural_user:change_me_in_local_env@localhost:5433/plural_upsell_test"

# CORS
CORS_ORIGINS='["http://localhost:3000","http://localhost:8000"]'

# Data paths
NORMALIZED_MAPPINGS_PATH="data/normalized/product_mappings.json"

# Stage 5: Order-Delivery Webhook Security & Technical Consent Gate
ORDER_WEBHOOK_AUTH_MODE="dev_insecure_open"
ORDER_WEBHOOK_SHARED_TOKEN=""
# REQUIRE_CONSENT_AUDIT_METADATA defaults to False in development/testing and True in staging/production

# Stage 6: WhatsApp Provider & Meta Cloud API Configuration
# Set WHATSAPP_PROVIDER="simulator" for local/founder walkthrough simulator mode,
# or WHATSAPP_PROVIDER="meta_cloud_api" for live Meta WhatsApp Cloud API dispatch.
WHATSAPP_PROVIDER="simulator"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""
WHATSAPP_TEMPLATE_NAME="plural_post_delivery_upsell_v1"
WHATSAPP_TEMPLATE_LANGUAGE="en_US"
WHATSAPP_HTTP_TIMEOUT_SECONDS="10.0"
